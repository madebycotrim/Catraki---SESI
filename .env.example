# ============================================================================
# CATRAKI SESI — VARIÁVEIS DE AMBIENTE (.env / .dev.vars)
# ============================================================================
# ⚠️  SEGURANÇA: Em produção, TODOS os segredos devem ser gerados com:
#     openssl rand -base64 32
#     NUNCA reutilize os valores de exemplo abaixo em produção.
# ============================================================================

# 0. AMBIENTE (controla comportamentos de dev vs produção)
# Em produção, NÃO defina esta variável ou defina como 'production'
APP_ENV=development

# 1. ENVIO DE E-MAIL (Resend API)
# Obtenha em https://resend.com/api-keys
RESEND_API_KEY=re_sua_chave_resend_aqui
EMAIL_FROM="Escola Cidadã — Saúde em Movimento <autorizacoes@catraki.com.br>"

# 2. CRIPTOGRAFIA E SEGURANÇA (AES-GCM 256-bit + HMAC)
# ⚠️  Gere com: openssl rand -base64 32
ENCRYPTION_KEY_V1=GERE_COM_openssl_rand_base64_32
OTP_PEPPER=GERE_COM_openssl_rand_base64_32
JWT_ADMIN_SECRET=GERE_COM_openssl_rand_base64_32

# 3. LOGIN CORPORATIVO MICROSOFT (Microsoft Entra ID / M365 - OAuth 2.0 PKCE SPA)
# Obtenha o Application (client) ID em https://portal.azure.com
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_TENANT_ID=common
ALLOWED_EMAIL_DOMAINS=sistemafibra.org.br

# 4. CLOUDFLARE TURNSTILE (Proteção Anti-Bot / CAPTCHA Inteligente)
# Chave pública configurada no widget do frontend
TURNSTILE_SITE_KEY=0x4AAAAAAEXS51wjeYSoRWAc
# Chave secreta (Secret Key) gerada no painel Cloudflare Turnstile
TURNSTILE_SECRET_KEY=COLE_AQUI_O_SEU_NOVO_SEGREDO_DO_TURNSTILE
# Hostnames autorizados para validação do backend (separados por vírgula)
TURNSTILE_HOSTNAMES=catraki.com.br,www.catraki.com.br,localhost,127.0.0.1

